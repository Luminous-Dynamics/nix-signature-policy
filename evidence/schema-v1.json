{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/nix-pqc-policy-evidence-v1.json",
  "title": "Nix PQC policy-decision evidence bundle v1",
  "type": "object",
  "required": [
    "bundle_schema_version",
    "payload_sha256",
    "payload"
  ],
  "properties": {
    "bundle_schema_version": {
      "const": 1
    },
    "payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    },
    "attestation": {
      "oneOf": [
        {
          "$ref": "#/$defs/attestation"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verification": {
      "enum": [
        "valid",
        "invalid",
        "malformed"
      ]
    },
    "decisionValue": {
      "enum": [
        "accept",
        "refuse"
      ]
    },
    "reasonCode": {
      "enum": [
        "invalid_policy",
        "forbidden_family",
        "deprecated_family",
        "observe_only_family",
        "no_active_clause",
        "policy_expired",
        "policy_not_active",
        "policy_rollback",
        "too_many_observations",
        "too_many_candidates",
        "duplicate_candidate",
        "conflicting_candidate",
        "unknown_key",
        "algorithm_mismatch",
        "invalid_signature",
        "malformed_signature",
        "revoked_key",
        "not_yet_valid_key",
        "expired_key",
        "missing_required_group",
        "missing_required_relation"
      ]
    },
    "producer": {
      "type": "object",
      "required": [
        "implementation",
        "version"
      ],
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "identifier",
        "sha256",
        "size_bytes",
        "adapter"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "groupRequirement": {
      "type": "object",
      "required": [
        "group"
      ],
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1
        },
        "min_distinct_identities": {
          "type": "integer",
          "minimum": 0
        },
        "min_distinct_families": {
          "type": "integer",
          "minimum": 0
        },
        "min_distinct_authorities": {
          "type": "integer",
          "minimum": 0
        },
        "min_distinct_custody_domains": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "minProperties": 2
    },
    "clause": {
      "type": "object",
      "required": [
        "clause_id",
        "required_groups"
      ],
      "properties": {
        "clause_id": {
          "type": "string",
          "minLength": 1
        },
        "required_groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/groupRequirement"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/groupRelation"
          }
        },
        "active_from": {
          "type": [
            "integer",
            "null"
          ]
        },
        "active_until": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "policy_id",
        "version",
        "epoch",
        "family_registry",
        "algorithm_registry",
        "group_definitions",
        "accept_if_any"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "max_signature_observations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "max_signature_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "algorithm_registry": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/algorithmDefinition"
          }
        },
        "group_definitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/groupDefinition"
          }
        },
        "accept_if_any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/clause"
          }
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "previous_policy_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "active_from": {
          "type": [
            "integer",
            "null"
          ]
        },
        "expires_at": {
          "type": [
            "integer",
            "null"
          ]
        },
        "family_registry": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/familyDefinition"
          }
        }
      },
      "additionalProperties": false
    },
    "trustedKey": {
      "type": "object",
      "required": [
        "key_id",
        "key_name",
        "signer_identity",
        "algorithm",
        "authority",
        "custody_domain"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "key_name": {
          "type": "string",
          "minLength": 1
        },
        "signer_identity": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "$ref": "#/$defs/nonEmptyStringSet"
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "custody_domain": {
          "type": "string",
          "minLength": 1
        },
        "revoked": {
          "type": "boolean"
        },
        "valid_from": {
          "type": [
            "integer",
            "null"
          ]
        },
        "valid_until": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "key_name",
        "algorithm",
        "signature_id",
        "verification"
      ],
      "properties": {
        "key_name": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "signature_id": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      },
      "additionalProperties": false
    },
    "candidateDiagnostic": {
      "type": "object",
      "required": [
        "key_name",
        "algorithm",
        "signature_id",
        "code"
      ],
      "properties": {
        "key_name": {
          "type": "string"
        },
        "algorithm": {
          "type": "string"
        },
        "signature_id": {
          "type": "string"
        },
        "code": {
          "$ref": "#/$defs/reasonCode"
        }
      },
      "additionalProperties": false
    },
    "groupObservation": {
      "type": "object",
      "required": [
        "group",
        "required_identities",
        "observed_identities",
        "signer_identities",
        "required_families",
        "observed_families",
        "families",
        "required_authorities",
        "observed_authorities",
        "authorities",
        "required_custody_domains",
        "observed_custody_domains",
        "custody_domains"
      ],
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1
        },
        "required_identities": {
          "type": "integer",
          "minimum": 0
        },
        "observed_identities": {
          "type": "integer",
          "minimum": 0
        },
        "signer_identities": {
          "$ref": "#/$defs/nonEmptyStringSet"
        },
        "required_families": {
          "type": "integer",
          "minimum": 0
        },
        "observed_families": {
          "type": "integer",
          "minimum": 0
        },
        "families": {
          "$ref": "#/$defs/nonEmptyStringSet"
        },
        "required_authorities": {
          "type": "integer",
          "minimum": 0
        },
        "observed_authorities": {
          "type": "integer",
          "minimum": 0
        },
        "authorities": {
          "$ref": "#/$defs/nonEmptyStringSet"
        },
        "required_custody_domains": {
          "type": "integer",
          "minimum": 0
        },
        "observed_custody_domains": {
          "type": "integer",
          "minimum": 0
        },
        "custody_domains": {
          "$ref": "#/$defs/nonEmptyStringSet"
        }
      },
      "additionalProperties": false
    },
    "clauseEvaluation": {
      "type": "object",
      "required": [
        "clause_id",
        "active",
        "satisfied",
        "groups",
        "relations"
      ],
      "properties": {
        "clause_id": {
          "type": "string",
          "minLength": 1
        },
        "satisfied": {
          "type": "boolean"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/groupObservation"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationEvaluation"
          }
        },
        "active": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "decision",
        "policy_id",
        "policy_version",
        "policy_epoch",
        "satisfied_clause",
        "raw_candidate_count",
        "unique_candidate_count",
        "eligible_candidate_count",
        "reason_codes",
        "candidate_diagnostics",
        "clause_evaluations"
      ],
      "properties": {
        "decision": {
          "$ref": "#/$defs/decisionValue"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "satisfied_clause": {
          "type": [
            "string",
            "null"
          ]
        },
        "unique_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reasonCode"
          },
          "uniqueItems": true
        },
        "candidate_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidateDiagnostic"
          }
        },
        "clause_evaluations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clauseEvaluation"
          }
        },
        "raw_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "policy_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "omitted_candidate_diagnostics": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "required": [
        "schema_version",
        "assurance",
        "producer",
        "source",
        "evaluation_time",
        "policy",
        "trusted_keys",
        "candidates",
        "decision",
        "minimum_policy_epoch"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "assurance": {
          "const": "policy_replay"
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "evaluation_time": {
          "type": "integer"
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "trusted_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trustedKey"
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "decision": {
          "$ref": "#/$defs/decision"
        },
        "minimum_policy_epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "attestation": {
      "type": "object",
      "required": [
        "algorithm",
        "key_name",
        "ed25519_public_key_base64",
        "ml_dsa_65_public_key_base64",
        "ed25519_signature_base64",
        "ml_dsa_65_signature_base64"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519+ml-dsa-65"
        },
        "key_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ed25519_public_key_base64": {
          "type": "string",
          "minLength": 1
        },
        "ml_dsa_65_public_key_base64": {
          "type": "string",
          "minLength": 1
        },
        "ed25519_signature_base64": {
          "type": "string",
          "minLength": 1
        },
        "ml_dsa_65_signature_base64": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "nonEmptyStringSet": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "algorithmDefinition": {
      "type": "object",
      "required": [
        "algorithm",
        "family",
        "assurance_class"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "assurance_class": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "groupPredicate": {
      "type": "object",
      "properties": {
        "match_all": {
          "type": "boolean"
        },
        "allowed_algorithms": {
          "$ref": "#/$defs/nonEmptyStringSet"
        },
        "allowed_families": {
          "$ref": "#/$defs/nonEmptyStringSet"
        },
        "allowed_assurance_classes": {
          "$ref": "#/$defs/nonEmptyStringSet"
        },
        "required_roles": {
          "$ref": "#/$defs/nonEmptyStringSet"
        },
        "allowed_authorities": {
          "$ref": "#/$defs/nonEmptyStringSet"
        },
        "allowed_custody_domains": {
          "$ref": "#/$defs/nonEmptyStringSet"
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "groupDefinition": {
      "type": "object",
      "required": [
        "group",
        "predicate"
      ],
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "$ref": "#/$defs/groupPredicate"
        }
      },
      "additionalProperties": false
    },
    "groupRelation": {
      "type": "object",
      "required": [
        "relation_id",
        "attribute",
        "mode",
        "groups"
      ],
      "properties": {
        "relation_id": {
          "type": "string",
          "minLength": 1
        },
        "attribute": {
          "enum": [
            "identity",
            "family",
            "authority",
            "custody_domain"
          ]
        },
        "mode": {
          "enum": [
            "same",
            "distinct"
          ]
        },
        "groups": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "relationWitness": {
      "type": "object",
      "required": [
        "group",
        "value"
      ],
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "relationEvaluation": {
      "type": "object",
      "required": [
        "relation_id",
        "attribute",
        "mode",
        "satisfied",
        "witnesses"
      ],
      "properties": {
        "relation_id": {
          "type": "string",
          "minLength": 1
        },
        "attribute": {
          "enum": [
            "identity",
            "family",
            "authority",
            "custody_domain"
          ]
        },
        "mode": {
          "enum": [
            "same",
            "distinct"
          ]
        },
        "satisfied": {
          "type": "boolean"
        },
        "witnesses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationWitness"
          }
        }
      },
      "additionalProperties": false
    },
    "familyStatus": {
      "enum": [
        "enabled",
        "observe_only",
        "deprecated",
        "forbidden"
      ]
    },
    "familyDefinition": {
      "type": "object",
      "required": [
        "family",
        "status"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/familyStatus"
        }
      },
      "additionalProperties": false
    }
  }
}
