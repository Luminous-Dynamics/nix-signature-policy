{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/nix-policy-conformance-manifest-v1.json",
  "title": "Nix signature-policy conformance manifest v1",
  "type": "object",
  "required": [
    "manifest_schema_version",
    "vector_schema_version",
    "normative_spec_revision",
    "profiles",
    "vectors"
  ],
  "properties": {
    "manifest_schema_version": {"const": 1},
    "vector_schema_version": {"const": 2},
    "normative_spec_revision": {"const": 1},
    "profiles": {
      "type": "object",
      "required": ["core-v1"],
      "properties": {
        "core-v1": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1},
        "uniqueItems": true
      }
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "path", "sha256", "adapter", "tags"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^policy-vectors/.+\\.json$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "adapter": {"enum": ["semantic", "sig-pqc", "algorithm-tagged"]},
          "tags": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
