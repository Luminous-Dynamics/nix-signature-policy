diff --git a/src/libutil/include/nix/util/signature-service-caller.hh b/src/libutil/include/nix/util/signature-service-caller.hh
new file mode 100644
index 0000000..67b632a
--- /dev/null
+++ b/src/libutil/include/nix/util/signature-service-caller.hh
@@ -0,0 +1,63 @@
+#pragma once
+///@file
+
+#include <chrono>
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace nix {
+
+/**
+ * A single observed signature returned by the persistent observation
+ * service (Model S). Same shape as O-process's `ObservedSignature` --
+ * this model differs from O-process only in transport (a long-lived
+ * Unix-domain socket connection instead of a fresh fork+exec per
+ * decision), not in wire semantics.
+ */
+struct ServiceObservedSignature
+{
+    std::string keyName;
+    std::string keyType;
+    std::string signatureId;
+};
+
+struct ServiceObservationResult
+{
+    bool failed = false;
+    std::vector<ServiceObservedSignature> observations;
+};
+
+struct SignatureObservationServiceConfig
+{
+    /**
+     * Absolute path to the service's Unix-domain socket.
+     */
+    std::filesystem::path socketPath;
+    std::chrono::milliseconds timeout;
+
+    static SignatureObservationServiceConfig validate(std::string_view socketPath, unsigned int timeoutMs);
+};
+
+/**
+ * Connect to the persistent observation service at
+ * `config.socketPath`, send one request (fingerprint + raw signature
+ * entries), and return the parsed observations. A new connection is
+ * made per call -- this prototype does not pool or reuse connections
+ * across admission decisions, only the *service process* persists.
+ *
+ * Throws only for configuration errors (validated up front by
+ * `SignatureObservationServiceConfig::validate`). Connection failure,
+ * timeout, or a malformed response are reported via
+ * `ServiceObservationResult::failed`, never a thrown exception -- a
+ * misbehaving or absent service is always a hard refusal upstream in
+ * `pathInfoIsUntrusted`, never a silent pass, matching every other
+ * model in this comparison.
+ */
+ServiceObservationResult invokeObservationService(
+    const SignatureObservationServiceConfig & config,
+    const std::string & fingerprint,
+    const std::vector<std::string> & rawSignatureEntries);
+
+} // namespace nix
