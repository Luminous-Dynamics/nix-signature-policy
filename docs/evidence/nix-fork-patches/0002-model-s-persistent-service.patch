+namespace {
+
+/**
+ * Parse `<group-name>:<key-name>[,<key-name>...]` entries into
+ * `KeyGroup`s. Throws (not a silent skip) on a malformed entry, so a
+ * typo in the setting is a hard configuration error, not a silently
+ * weaker policy. Identical shape to Model O-provider's parser -- not
+ * shared code, per this comparison's isolation discipline (each
+ * model's branch is independently buildable from the shared
+ * foundation).
+ */
+std::vector<KeyGroup> parseSignatureObservationServiceKeyGroups(const Strings & entries)
+{
+    std::vector<KeyGroup> groups;
+    for (auto & entry : entries) {
+        auto colon = entry.find(':');
+        if (colon == std::string::npos || colon == 0 || colon == entry.size() - 1)
+            throw Error(
+                "invalid signature-observation-service-key-groups entry '%s' "
+                "(expected '<group-name>:<key-name>[,<key-name>...]')",
+                entry);
+        KeyGroup group{.name = entry.substr(0, colon), .requiredKeyNames = {}};
+        std::string rest = entry.substr(colon + 1);
+        size_t pos = 0;
+        while (pos < rest.size()) {
+            auto comma = rest.find(',', pos);
+            auto keyName = rest.substr(pos, comma == std::string::npos ? std::string::npos : comma - pos);
+            if (keyName.empty())
+                throw Error(
+                    "invalid signature-observation-service-key-groups entry '%s' (empty key name)", entry);
+            group.requiredKeyNames.push_back(keyName);
+            if (comma == std::string::npos)
+                break;
+            pos = comma + 1;
+        }
+        groups.push_back(std::move(group));
+    }
+    return groups;
+}
+
+} // namespace
+
 bool LocalStore::pathInfoIsUntrusted(const ValidPathInfo & info)
 {
-    return config->requireSigs && !info.checkSignatures(*this, getPublicKeys());
+    if (!config->requireSigs)
+        return false;
+
+    auto sigCheck = info.checkSignaturesDetailed(*this, getPublicKeys());
+    bool nativeTrusted = sigCheck.validCount != 0;
+
+    auto mode = config->signatureObservationServiceMode.get();
+    if (mode == "legacy")
+        return !nativeTrusted;
+    if (mode != "conjunctive")
+        throw Error(
+            "invalid signature-observation-service-mode '%s' (must be 'legacy' or 'conjunctive')", mode);
+
+    if (info.isContentAddressed(*this)) {
+        warn(
+            "signature-observation-service-mode=conjunctive: content-addressed path '%s' has no "
+            "meaningful signature policy; refusing",
+            printStorePath(info.path));
+        return true;
+    }
+
+    if (!nativeTrusted)
+        return true;
+
+    auto serviceConfig = SignatureObservationServiceConfig::validate(
+        config->signatureObservationServiceSocket.get(), config->signatureObservationServiceTimeoutMs.get());
+    auto groups = parseSignatureObservationServiceKeyGroups(config->signatureObservationServiceKeyGroups.get());
+
+    /* Only key names actually referenced by a configured group are
+       candidates for the service at all -- same rationale as
+       O-provider: the service need not support every algorithm Nix's
+       native check does. */
+    std::set<std::string> requiredKeyNames;
+    for (auto & group : groups)
+        for (auto & name : group.requiredKeyNames)
+            requiredKeyNames.insert(name);
+
+    /* One request per admission decision (not per signature -- the
+       request carries every raw `Sig:` entry the configured groups
+       care about together), sent over a fresh connection to the
+       already-running service. */
+    auto fp = info.fingerprint(*this);
+    auto & publicKeys = getPublicKeys();
+    std::vector<std::string> rawSignatureEntries;
+    for (auto & sig : info.sigs)
+        if (requiredKeyNames.contains(sig.keyName))
+            rawSignatureEntries.push_back(sig.to_string());
+
+    auto result = invokeObservationService(serviceConfig, fp, rawSignatureEntries);
+    if (result.failed)
+        return true;
+
+    std::vector<ValidPathInfo::VerifiedSignature> observed;
+    for (auto & o : result.observations) {
+        auto key = publicKeys.find(o.keyName);
+        if (key == publicKeys.end())
+            // The service claimed a key name Nix doesn't itself trust
+            // -- ignore it rather than trust the service's own
+            // algorithm label. Nix's trusted-key registry, not the
+            // service, decides which keys are eligible.
+            continue;
+        observed.push_back(ValidPathInfo::VerifiedSignature{
+            .keyName = o.keyName,
+            .keyType = key->second->keyType(),
+            .signatureId = o.signatureId,
+        });
+    }
+
+    return !allSignatureGroupsSatisfied(observed, groups);
 }
 
 bool LocalStore::realisationIsUntrusted(const Realisation & realisation)
