diff --git a/src/libutil/signature-service-caller.cc b/src/libutil/signature-service-caller.cc
new file mode 100644
index 0000000..2002fdb
--- /dev/null
+++ b/src/libutil/signature-service-caller.cc
@@ -0,0 +1,181 @@
+#include "nix/util/signature-service-caller.hh"
+#include "nix/util/unix-domain-socket.hh"
+#include "nix/util/file-descriptor.hh"
+#include "nix/util/error.hh"
+
+#include <nlohmann/json.hpp>
+
+#include <algorithm>
+#include <chrono>
+#include <climits>
+#include <cstddef>
+#include <span>
+
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+namespace nix {
+
+namespace {
+
+constexpr size_t MAX_RESPONSE_BYTES = 2 * 1024 * 1024;
+constexpr size_t MAX_OBSERVATIONS = 128;
+constexpr unsigned int MAX_REASONABLE_TIMEOUT_MS = 60000;
+
+std::string buildRequestJson(const std::string & fingerprint, const std::vector<std::string> & rawSignatureEntries)
+{
+    nlohmann::json j = {
+        {"fingerprint", fingerprint},
+        {"signatures", rawSignatureEntries},
+    };
+    return j.dump();
+}
+
+/**
+ * Read until EOF or `deadline`, bounded to `cap` bytes kept (excess is
+ * discarded, not left to block a full pipe -- though a Unix socket
+ * from a well-behaved service should never fill a pipe buffer the way
+ * a verbose subprocess might; kept for defense in depth and symmetry
+ * with every other model's caller in this comparison).
+ *
+ * Returns `{data, true}` on any timeout, poll error, or read error --
+ * the caller treats all of these as `failed`, never distinguishes a
+ * partial read from a clean one.
+ */
+struct DrainResult
+{
+    std::string data;
+    bool timedOutOrErrored = false;
+};
+
+DrainResult drainWithDeadline(int fd, size_t cap, std::chrono::steady_clock::time_point deadline)
+{
+    DrainResult result;
+    std::byte chunk[65536];
+    while (true) {
+        auto now = std::chrono::steady_clock::now();
+        if (now >= deadline) {
+            result.timedOutOrErrored = true;
+            return result;
+        }
+        auto remainingMs = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - now).count();
+        struct pollfd pfd{.fd = fd, .events = POLLIN, .revents = 0};
+        int pollResult = poll(&pfd, 1, static_cast<int>(std::min<long>(remainingMs, INT_MAX)));
+        if (pollResult < 0) {
+            result.timedOutOrErrored = true;
+            return result;
+        }
+        if (pollResult == 0) {
+            // Deadline reached with nothing to read.
+            result.timedOutOrErrored = true;
+            return result;
+        }
+        if (pfd.revents & (POLLERR | POLLNVAL)) {
+            result.timedOutOrErrored = true;
+            return result;
+        }
+        size_t n;
+        try {
+            n = read(fd, std::span(chunk));
+        } catch (SystemError &) {
+            result.timedOutOrErrored = true;
+            return result;
+        }
+        if (n == 0)
+            // EOF: the service closed the connection after writing its
+            // full response. This is the normal, successful end state.
+            return result;
+        size_t room = result.data.size() < cap ? cap - result.data.size() : 0;
+        size_t take = std::min(room, n);
+        if (take > 0)
+            result.data.append(reinterpret_cast<const char *>(chunk), take);
+        // Bytes beyond `cap` are silently discarded, not treated as an
+        // error -- matches the other models' "overflow -> failed"
+        // handling being applied by the caller after this returns,
+        // via the response-parse step naturally rejecting an
+        // over-long/truncated JSON body.
+    }
+}
+
+} // namespace
+
+SignatureObservationServiceConfig
+SignatureObservationServiceConfig::validate(std::string_view socketPath, unsigned int timeoutMs)
+{
+    if (socketPath.empty())
+        throw UsageError(
+            "'signature-observation-service-socket' must be set when 'signature-observation-service-mode' is 'conjunctive'");
+
+    std::filesystem::path path{socketPath};
+    if (!path.is_absolute())
+        throw UsageError(
+            "'signature-observation-service-socket' must be an absolute path (got '%s')", socketPath);
+
+    if (timeoutMs == 0)
+        throw UsageError("'signature-observation-service-timeout-ms' must be nonzero");
+    if (timeoutMs > MAX_REASONABLE_TIMEOUT_MS)
+        throw UsageError(
+            "'signature-observation-service-timeout-ms' (%d) exceeds the maximum of %d",
+            timeoutMs,
+            MAX_REASONABLE_TIMEOUT_MS);
+
+    return SignatureObservationServiceConfig{path, std::chrono::milliseconds{timeoutMs}};
+}
+
+ServiceObservationResult invokeObservationService(
+    const SignatureObservationServiceConfig & config,
+    const std::string & fingerprint,
+    const std::vector<std::string> & rawSignatureEntries)
+{
+    auto deadline = std::chrono::steady_clock::now() + config.timeout;
+    auto requestJson = buildRequestJson(fingerprint, rawSignatureEntries);
+
+    AutoCloseFD fd;
+    try {
+        fd = connect(config.socketPath);
+    } catch (Error &) {
+        // No service listening, permission denied, stale/missing
+        // socket file, etc. -- always a hard failure upstream, never
+        // silently treated as "no observations required."
+        return ServiceObservationResult{.failed = true, .observations = {}};
+    }
+
+    try {
+        writeFull(fd.get(), requestJson, /*allowInterrupts=*/false);
+    } catch (SystemError &) {
+        return ServiceObservationResult{.failed = true, .observations = {}};
+    }
+    // Half-close: signals to the service that the full request has
+    // been sent, mirroring how every fork/exec-based caller in this
+    // comparison closes the write side of the child's stdin pipe.
+    shutdown(fd.get(), SHUT_WR);
+
+    auto drained = drainWithDeadline(fd.get(), MAX_RESPONSE_BYTES, deadline);
+    if (drained.timedOutOrErrored)
+        return ServiceObservationResult{.failed = true, .observations = {}};
+
+    try {
+        auto parsed = nlohmann::json::parse(drained.data);
+        auto candidatesJson = parsed.at("candidates");
+        if (!candidatesJson.is_array() || candidatesJson.size() > MAX_OBSERVATIONS)
+            return ServiceObservationResult{.failed = true, .observations = {}};
+
+        std::vector<ServiceObservedSignature> observations;
+        for (auto & c : candidatesJson) {
+            auto verification = c.at("verification").get<std::string>();
+            if (verification != "valid")
+                continue;
+            observations.push_back(ServiceObservedSignature{
+                .keyName = c.at("key_name").get<std::string>(),
+                .keyType = c.at("algorithm").get<std::string>(),
+                .signatureId = c.at("signature_id").get<std::string>(),
+            });
+        }
+        return ServiceObservationResult{.failed = false, .observations = std::move(observations)};
+    } catch (...) {
+        return ServiceObservationResult{.failed = true, .observations = {}};
+    }
+}
+
+} // namespace nix
