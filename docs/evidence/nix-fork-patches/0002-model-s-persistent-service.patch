diff --git a/src/libstore/include/nix/store/local-store.hh b/src/libstore/include/nix/store/local-store.hh
index fde17c3..0fdd679 100644
--- a/src/libstore/include/nix/store/local-store.hh
+++ b/src/libstore/include/nix/store/local-store.hh
@@ -155,6 +155,88 @@ public:
         true,
         Xp::ConfigurableSignatureAuthorization};
 
+    Setting<std::string> signatureObservationServiceSocket{
+        this,
+        "",
+        "signature-observation-service-socket",
+        R"(
+          Optional. Absolute path to a persistent observation service's
+          Unix-domain socket (Model S in the authorization-boundary-
+          architecture comparison -- a prototype persistent successor
+          to `signature-observation-provider`'s spawned-helper
+          transport). The path must be absolute.
+
+          Unlike `signature-observation-provider`, no process is
+          spawned per admission decision: Nix connects to an
+          already-running service process over this socket, sends one
+          request, and reads one response per decision. The service
+          itself only reports whether a signature verifies -- it
+          cannot admit or refuse a path; Nix always composes its
+          report with Nix's own signature-group policy
+          (`signature-key-group`, shared with Models N/O-process/
+          O-provider).
+
+          This option is only settable in the global `nix.conf`, or on
+          the command line by trusted users.
+        )",
+        {},
+        true,
+        Xp::ConfigurableSignatureAuthorization};
+
+    Setting<std::string> signatureObservationServiceMode{
+        this,
+        "legacy",
+        "signature-observation-service-mode",
+        R"(
+          How the result of `signature-observation-service-socket` is
+          combined with Nix's own trusted-signature check. One of:
+
+          - `legacy`: the service, if configured, is not consulted.
+            Admission is exactly Nix's existing trusted-signature
+            behavior.
+
+          - `conjunctive`: a store path is admitted only if Nix's own
+            trusted-signature check accepts it *and* the resulting
+            verified-signature observations satisfy every group in
+            `signature-key-group`. A service that is unset, refuses
+            the connection, times out, or returns a malformed response
+            is treated as a refusal, never a silent acceptance.
+            Content-addressed paths are refused under this mode rather
+            than silently admitted.
+
+          Any other value is a configuration error.
+        )",
+        {},
+        true,
+        Xp::ConfigurableSignatureAuthorization};
+
+    Setting<unsigned int> signatureObservationServiceTimeoutMs{
+        this,
+        2000,
+        "signature-observation-service-timeout-ms",
+        "Milliseconds to wait for `signature-observation-service-socket` before treating the request as failed "
+        "(and, in `conjunctive` mode, refusing the path).",
+        {},
+        true,
+        Xp::ConfigurableSignatureAuthorization};
+
+    Setting<Strings> signatureObservationServiceKeyGroups{
+        this,
+        {},
+        "signature-observation-service-key-groups",
+        R"(
+          Zero or more required signature groups, each in the form
+          `<group-name>:<key-name>[,<key-name>...]`. Under
+          `signature-observation-service-mode = conjunctive`, a path
+          is admitted only if, for every listed group, at least one of
+          that group's key names produced a signature the service
+          verified as valid. Shared format and evaluation with Model
+          N's `signature-key-group`.
+        )",
+        {},
+        true,
+        Xp::ConfigurableSignatureAuthorization};
+
     Setting<bool> readOnly{
         this,
         false,
