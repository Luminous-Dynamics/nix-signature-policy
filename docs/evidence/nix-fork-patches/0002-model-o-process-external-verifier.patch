+namespace {
+
+/**
+ * Parse `signature-key-group` entries (`<group-name>:<key-name>[,<key-name>...]`)
+ * into `KeyGroup`s for `allSignatureGroupsSatisfied`. A malformed entry
+ * (no `:`) is a configuration error, not silently skipped -- an operator
+ * who mistyped a group is entitled to a hard failure, not a policy that's
+ * quietly easier to satisfy than they intended.
+ */
+std::vector<KeyGroup> parseSignatureKeyGroups(const Strings & entries)
+{
+    std::vector<KeyGroup> groups;
+    for (auto & entry : entries) {
+        auto colon = entry.find(':');
+        if (colon == std::string::npos)
+            throw Error("invalid 'signature-key-group' entry '%s': expected '<group-name>:<key-name>[,<key-name>...]'", entry);
+        KeyGroup group;
+        group.name = entry.substr(0, colon);
+        for (auto & keyName : tokenizeString<Strings>(entry.substr(colon + 1), ","))
+            group.requiredKeyNames.push_back(keyName);
+        groups.push_back(std::move(group));
+    }
+    return groups;
+}
+
+} // namespace
+
 bool LocalStore::pathInfoIsUntrusted(const ValidPathInfo & info)
 {
-    return config->requireSigs && !info.checkSignatures(*this, getPublicKeys());
+    if (!config->requireSigs)
+        return false;
+
+    auto sigCheck = info.checkSignaturesDetailed(*this, getPublicKeys());
+    bool nativeTrusted = sigCheck.validCount != 0;
+
+    auto mode = config->signatureObservationProviderMode.get();
+
+    if (mode == "legacy")
+        // Never launches the provider, even if one is configured -- same
+        // no-behavior-change guarantee as Model H's legacy mode.
+        return !nativeTrusted;
+
+    if (mode != "conjunctive")
+        throw Error(
+            "invalid 'signature-observation-provider-mode' \"%s\"; must be 'legacy' or 'conjunctive'", mode);
+
+    if (info.isContentAddressed(*this)) {
+        // Same explicit fail-closed CA-path handling as Model H, for the
+        // same reason: conjunctive mode must never be silently
+        // equivalent to legacy for CA paths.
+        warn(
+            "refusing content-addressed path '%s': signature-observation-provider-mode=conjunctive "
+            "does not support content-addressed paths in this experiment",
+            printStorePath(info.path));
+        return true;
+    }
+
+    if (!nativeTrusted)
+        return true;
+
+    auto providerConfig = SignatureObservationProviderConfig::validate(
+        config->signatureObservationProvider.get(), config->signatureObservationProviderTimeoutMs.get());
+
+    std::vector<std::string> rawSignatureEntries;
+    rawSignatureEntries.reserve(info.sigs.size());
+    for (auto & sig : info.sigs)
+        rawSignatureEntries.push_back(sig.to_string());
+
+    auto result = invokeObservationProvider(providerConfig, info.fingerprint(*this), rawSignatureEntries);
+
+    // A failed invocation (crash, timeout, malformed response) carries no
+    // observations, which -- combined with any non-empty configured
+    // group requiring at least one key -- already fails closed via
+    // allSignatureGroupsSatisfied without needing a separate check here.
+    // An explicit check is still clearer than relying on that fact
+    // silently holding for every possible group configuration.
+    if (result.failed)
+        return true;
+
+    std::vector<ValidPathInfo::VerifiedSignature> observed;
+    observed.reserve(result.observations.size());
+    for (auto & o : result.observations)
+        observed.push_back(ValidPathInfo::VerifiedSignature{
+            .keyName = o.keyName,
+            .keyType = o.keyType,
+            .signatureId = o.signatureId,
+        });
+
+    auto groups = parseSignatureKeyGroups(config->signatureKeyGroups.get());
+    return !allSignatureGroupsSatisfied(observed, groups);
 }
 
 bool LocalStore::realisationIsUntrusted(const Realisation & realisation)
