+    /**
+     * Model O ("external verifier returns O; Nix owns native narrow
+     * policy") from the admission-boundary architecture comparison --
+     * distinct from `signatureAuthorizationHook` (Model H): this
+     * provider is handed *raw, unverified* evidence and returns
+     * *observations*, never a final decision. Nix evaluates its own
+     * grouped-signature policy (`allSignatureGroupsSatisfied`, shared
+     * with Model N) over whatever the provider reports.
+     */
+    Setting<std::string> signatureObservationProvider{
+        this,
+        "",
+        "signature-observation-provider",
+        R"(
+          Optional. Absolute path to an external program that verifies
+          raw, unverified `Sig:` evidence and reports which signatures it
+          positively verified -- never a final admission decision. Nix
+          evaluates its own native grouped-signature policy over the
+          returned observations, composed with the ordinary
+          `trusted-public-keys` check.
+
+          The path must be absolute; no `PATH` lookup is performed. When
+          empty (the default), no external program is consulted.
+        )",
+        {},
+        true,
+        Xp::ConfigurableSignatureAuthorization};
+
+    Setting<std::string> signatureObservationProviderMode{
+        this,
+        "legacy",
+        "signature-observation-provider-mode",
+        R"(
+          How observations from `signature-observation-provider` are
+          combined with Nix's own trusted-signature check and native
+          grouped-signature policy. One of:
+
+          - `legacy`: the provider, if configured, is not consulted.
+
+          - `conjunctive`: a store path is admitted only if *both* Nix's
+            own trusted-signature check *and* the configured
+            `signature-key-group` requirements (evaluated over the
+            provider's reported observations) are satisfied. A provider
+            that is unset, times out, crashes, or returns a malformed
+            response reports zero observations, never a silent
+            acceptance.
+
+          Any other value is a configuration error.
+        )",
+        {},
+        true,
+        Xp::ConfigurableSignatureAuthorization};
+
+    Setting<unsigned int> signatureObservationProviderTimeoutMs{
+        this,
+        2000,
+        "signature-observation-provider-timeout-ms",
+        "Milliseconds to wait for `signature-observation-provider` before treating the invocation as failed.",
+        {},
+        true,
+        Xp::ConfigurableSignatureAuthorization};
+
+    /**
+     * One or more `<group-name>:<key-name>[,<key-name>...]` entries.
+     * Every listed key name must appear among the observation provider's
+     * reported observations for that group to be satisfied; every
+     * configured group must be satisfied for
