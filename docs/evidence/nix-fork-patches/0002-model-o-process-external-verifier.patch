diff --git a/src/libutil/include/nix/util/signature-observation-caller.hh b/src/libutil/include/nix/util/signature-observation-caller.hh
new file mode 100644
index 0000000..fbb5b25
--- /dev/null
+++ b/src/libutil/include/nix/util/signature-observation-caller.hh
@@ -0,0 +1,96 @@
+#pragma once
+///@file
+
+#include <chrono>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "nix/util/signature/local-keys.hh"
+
+namespace nix {
+
+/**
+ * One observation returned by an external observation provider: which key
+ * name and algorithm positively verified a signature, and its opaque
+ * signature identity. Mirrors `ValidPathInfo::VerifiedSignature` (this
+ * header has no `libstore` dependency, so it cannot use that type
+ * directly) -- callers convert between the two.
+ *
+ * Unlike Model H's `AuthorizationCandidate` (already-verified evidence
+ * Nix hands *to* the external component), this is evidence the external
+ * component hands *back* -- the provider verified raw, unverified
+ * signatures itself and is reporting what it found. Nix never trusts a
+ * `verification` field the provider might have echoed back; only entries
+ * the provider actually reported are ever constructed here, so their
+ * existence in this vector already means "reported positively verified."
+ */
+struct ObservedSignature
+{
+    std::string keyName;
+    KeyType keyType;
+    std::string signatureId;
+};
+
+/**
+ * The result of consulting an external observation provider.
+ *
+ * `Failure` (missing executable, crash, timeout, malformed/oversized
+ * response, protocol error) carries no observations and is deliberately
+ * not representable as "zero observations found" -- a caller must be able
+ * to distinguish "the provider ran and verified nothing" from "the
+ * provider could not be consulted at all," even though both currently
+ * lead to the same fail-closed native-policy outcome (`observations` is
+ * empty in the crash/malformed-provider case too; policy that requires N>0
+ * observations refuses on empty either way).
+ */
+struct ObservationProviderResult
+{
+    bool failed = false;
+    std::vector<ObservedSignature> observations;
+};
+
+/**
+ * Validated, ready-to-use observation-provider configuration. Constructed
+ * only via `SignatureObservationProviderConfig::validate`.
+ */
+class SignatureObservationProviderConfig
+{
+    SignatureObservationProviderConfig(std::string providerPath, std::chrono::milliseconds timeout);
+
+public:
+    const std::string providerPath;
+    const std::chrono::milliseconds timeout;
+
+    /**
+     * Same preconditions as Model H's `AuthorizationHookConfig::validate`
+     * (absolute path only, nonzero timeout bounded by
+     * `maxReasonableTimeoutMs`) -- recreated here rather than shared
+     * across branches, per this comparison's isolation discipline.
+     */
+    static SignatureObservationProviderConfig validate(std::string_view providerPath, unsigned int timeoutMs);
+};
+
+/**
+ * Invoke the configured external observation provider with raw,
+ * unverified signature evidence (the canonical fingerprint and the raw
+ * `name:base64` `Sig:` entries, verbatim) and return whatever verified
+ * observations it reports. Nix does not send its own trusted-key
+ * registry to the provider -- the provider is expected to own its own
+ * trust source, exactly as `nix-signature-policy`'s `verify_raw_evidence`
+ * is designed to be invoked (the registry is trusted local
+ * configuration, never wire input). Nix's *own* native policy is
+ * evaluated separately, by the caller, over the returned observations.
+ *
+ * Same hardened process-invocation properties as Model H's caller
+ * (recreated independently, not shared code, per this comparison's
+ * branch-isolation discipline): direct execve, no shell, no `PATH`
+ * lookup, cleared environment; reader threads armed before the stdin
+ * write; dual process-group and direct-pid `SIGKILL` on timeout; a
+ * failed invocation's output is never inspected.
+ */
+ObservationProviderResult invokeObservationProvider(
+    const SignatureObservationProviderConfig & config, const std::string & fingerprint,
+    const std::vector<std::string> & rawSignatureEntries);
+
+} // namespace nix
