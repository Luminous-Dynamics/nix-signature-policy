diff --git a/src/libutil/signature-observation-caller.cc b/src/libutil/signature-observation-caller.cc
new file mode 100644
index 0000000..6fb28f7
--- /dev/null
+++ b/src/libutil/signature-observation-caller.cc
@@ -0,0 +1,224 @@
+#include "nix/util/signature-observation-caller.hh"
+#include "nix/util/processes.hh"
+#include "nix/util/file-descriptor.hh"
+#include "nix/util/error.hh"
+
+#include <nlohmann/json.hpp>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <filesystem>
+#include <span>
+#include <thread>
+
+#include <signal.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+namespace nix {
+
+namespace {
+
+constexpr size_t MAX_RESPONSE_BYTES = 2 * 1024 * 1024;
+constexpr size_t MAX_DIAGNOSTIC_BYTES = 64 * 1024;
+constexpr unsigned int MAX_REASONABLE_TIMEOUT_MS = 60000;
+constexpr size_t MAX_OBSERVATIONS = 128;
+
+struct DrainResult
+{
+    std::string data;
+    bool overflowed = false;
+};
+
+/**
+ * Same bounded-drain shape as Model H's caller: keeps reading (and
+ * discarding) past `cap` rather than stopping early, so a verbose
+ * provider is never left blocked on a full pipe.
+ */
+DrainResult drainBounded(int fd, size_t cap)
+{
+    DrainResult result;
+    std::byte chunk[65536];
+    while (true) {
+        size_t n;
+        try {
+            n = read(fd, std::span(chunk));
+        } catch (SystemError &) {
+            break;
+        }
+        if (n == 0)
+            break;
+        size_t room = result.data.size() < cap ? cap - result.data.size() : 0;
+        size_t take = std::min(room, n);
+        if (take > 0)
+            result.data.append(reinterpret_cast<const char *>(chunk), take);
+        if (take < n)
+            result.overflowed = true;
+    }
+    return result;
+}
+
+void writeAll(int fd, std::string_view data)
+{
+    size_t written = 0;
+    while (written < data.size()) {
+        auto remaining = std::as_bytes(std::span(data.data() + written, data.size() - written));
+        size_t n;
+        try {
+            n = write(fd, remaining, /*allowInterrupts=*/false);
+        } catch (SystemError &) {
+            break;
+        }
+        if (n == 0)
+            break;
+        written += n;
+    }
+}
+
+std::string buildVerifyRawRequestJson(const std::string & fingerprint, const std::vector<std::string> & rawSignatureEntries)
+{
+    nlohmann::json j = {
+        {"fingerprint", fingerprint},
+        {"signatures", rawSignatureEntries},
+    };
+    return j.dump();
+}
+
+} // namespace
+
+SignatureObservationProviderConfig::SignatureObservationProviderConfig(
+    std::string providerPath, std::chrono::milliseconds timeout)
+    : providerPath(std::move(providerPath))
+    , timeout(timeout)
+{
+}
+
+SignatureObservationProviderConfig SignatureObservationProviderConfig::validate(
+    std::string_view providerPath, unsigned int timeoutMs)
+{
+    if (providerPath.empty())
+        throw UsageError(
+            "'signature-observation-provider' must be set when 'signature-observation-provider-mode' is 'conjunctive'");
+
+    std::filesystem::path path{providerPath};
+    if (!path.is_absolute())
+        throw UsageError(
+            "'signature-observation-provider' must be an absolute path (got '%s'); no PATH lookup is ever performed",
+            providerPath);
+
+    if (timeoutMs == 0)
+        throw UsageError("'signature-observation-provider-timeout-ms' must be nonzero");
+    if (timeoutMs > MAX_REASONABLE_TIMEOUT_MS)
+        throw UsageError(
+            "'signature-observation-provider-timeout-ms' (%d) exceeds the maximum of %d",
+            timeoutMs,
+            MAX_REASONABLE_TIMEOUT_MS);
+
+    return SignatureObservationProviderConfig{std::string{providerPath}, std::chrono::milliseconds{timeoutMs}};
+}
+
+ObservationProviderResult invokeObservationProvider(
+    const SignatureObservationProviderConfig & config,
+    const std::string & fingerprint,
+    const std::vector<std::string> & rawSignatureEntries)
+{
+    auto requestJson = buildVerifyRawRequestJson(fingerprint, rawSignatureEntries);
+
+    Pipe stdinPipe, stdoutPipe, stderrPipe;
+    stdinPipe.create();
+    stdoutPipe.create();
+    stderrPipe.create();
+
+    int stdinReadFd = stdinPipe.readSide.get();
+    int stdoutWriteFd = stdoutPipe.writeSide.get();
+    int stderrWriteFd = stderrPipe.writeSide.get();
+    const std::string providerPath = config.providerPath;
+
+    pid_t rawPid = startProcess([providerPath, stdinReadFd, stdoutWriteFd, stderrWriteFd]() {
+        if (setpgid(0, 0) != 0)
+            _exit(127);
+
+        if (dup2(stdinReadFd, STDIN_FILENO) == -1)
+            _exit(127);
+        if (dup2(stdoutWriteFd, STDOUT_FILENO) == -1)
+            _exit(127);
+        if (dup2(stderrWriteFd, STDERR_FILENO) == -1)
+            _exit(127);
+
+        unix::closeExtraFDs();
+
+        char * const argv[] = {const_cast<char *>(providerPath.c_str()), nullptr};
+        char * const envp[] = {nullptr};
+        execve(providerPath.c_str(), argv, envp);
+        _exit(127);
+    });
+
+    stdinPipe.readSide.close();
+    stdoutPipe.writeSide.close();
+    stderrPipe.writeSide.close();
+
+    DrainResult stdoutResult, stderrResult;
+    std::thread stdoutReader([&] { stdoutResult = drainBounded(stdoutPipe.readSide.get(), MAX_RESPONSE_BYTES); });
+    std::thread stderrReader([&] { stderrResult = drainBounded(stderrPipe.readSide.get(), MAX_DIAGNOSTIC_BYTES); });
+
+    writeAll(stdinPipe.writeSide.get(), requestJson);
+    stdinPipe.writeSide.close();
+
+    std::atomic<bool> completed{false};
+    int status = 0;
+    std::thread waiter([&] {
+        Pid pid(rawPid);
+        status = pid.wait(/*allowInterrupts=*/false);
+        completed.store(true, std::memory_order_release);
+    });
+
+    auto deadline = std::chrono::steady_clock::now() + config.timeout;
+    while (!completed.load(std::memory_order_acquire) && std::chrono::steady_clock::now() < deadline)
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+
+    bool timedOut = !completed.load(std::memory_order_acquire);
+    if (timedOut) {
+        ::kill(-rawPid, SIGKILL);
+        ::kill(rawPid, SIGKILL);
+    }
+
+    waiter.join();
+    stdoutReader.join();
+    stderrReader.join();
+
+    if (timedOut)
+        return ObservationProviderResult{.failed = true, .observations = {}};
+
+    if (stdoutResult.overflowed || !WIFEXITED(status) || WEXITSTATUS(status) != 0)
+        return ObservationProviderResult{.failed = true, .observations = {}};
+
+    try {
+        auto parsed = nlohmann::json::parse(stdoutResult.data);
+        auto candidatesJson = parsed.at("candidates");
+        if (!candidatesJson.is_array() || candidatesJson.size() > MAX_OBSERVATIONS)
+            return ObservationProviderResult{.failed = true, .observations = {}};
+
+        std::vector<ObservedSignature> observations;
+        for (auto & c : candidatesJson) {
+            auto verification = c.at("verification").get<std::string>();
+            if (verification != "valid")
+                // Not this provider's job to report negative outcomes as
+                // observations -- Model O's whole point is that Nix's
+                // native policy only ever sees positively verified
+                // evidence, exactly like ValidPathInfo::VerifiedSignature.
+                continue;
+            observations.push_back(ObservedSignature{
+                .keyName = c.at("key_name").get<std::string>(),
+                .keyType = parseKeyType(c.at("algorithm").get<std::string>()),
+                .signatureId = c.at("signature_id").get<std::string>(),
+            });
+        }
+        return ObservationProviderResult{.failed = false, .observations = std::move(observations)};
+    } catch (...) {
+        return ObservationProviderResult{.failed = true, .observations = {}};
+    }
+}
