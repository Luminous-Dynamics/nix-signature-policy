 #include <algorithm>
 #include <cstring>
@@ -998,9 +1001,114 @@ const PublicKeys & LocalStore::getPublicKeys()
     return *state->publicKeys;
 }
 
+namespace {
+
+/**
+ * Parse `<group-name>:<key-name>[,<key-name>...]` entries into
+ * `KeyGroup`s. Throws (not a silent skip) on a malformed entry, so a
+ * typo in the setting is a hard configuration error, not a silently
+ * weaker policy.
+ */
+std::vector<KeyGroup> parseSignatureObservationKeyGroups(const Strings & entries)
+{
+    std::vector<KeyGroup> groups;
+    for (auto & entry : entries) {
+        auto colon = entry.find(':');
+        if (colon == std::string::npos || colon == 0 || colon == entry.size() - 1)
+            throw Error(
+                "invalid signature-observation-provider-key-groups entry '%s' "
+                "(expected '<group-name>:<key-name>[,<key-name>...]')",
+                entry);
+        KeyGroup group{.name = entry.substr(0, colon), .requiredKeyNames = {}};
+        std::string rest = entry.substr(colon + 1);
+        size_t pos = 0;
+        while (pos < rest.size()) {
+            auto comma = rest.find(',', pos);
+            auto keyName = rest.substr(pos, comma == std::string::npos ? std::string::npos : comma - pos);
+            if (keyName.empty())
+                throw Error("invalid signature-observation-provider-key-groups entry '%s' (empty key name)", entry);
+            group.requiredKeyNames.push_back(keyName);
+            if (comma == std::string::npos)
+                break;
+            pos = comma + 1;
+        }
+        groups.push_back(std::move(group));
+    }
+    return groups;
+}
+
+} // namespace
+
 bool LocalStore::pathInfoIsUntrusted(const ValidPathInfo & info)
 {
-    return config->requireSigs && !info.checkSignatures(*this, getPublicKeys());
+    if (!config->requireSigs)
+        return false;
+
+    auto sigCheck = info.checkSignaturesDetailed(*this, getPublicKeys());
+    bool nativeTrusted = sigCheck.validCount != 0;
+
+    auto mode = config->signatureObservationProviderMode.get();
+    if (mode == "legacy")
+        return !nativeTrusted;
+    if (mode != "conjunctive")
+        throw Error(
+            "invalid signature-observation-provider-mode '%s' (must be 'legacy' or 'conjunctive')", mode);
+
+    if (info.isContentAddressed(*this)) {
+        warn(
+            "signature-observation-provider-mode=conjunctive: content-addressed path '%s' has no "
+            "meaningful signature policy; refusing",
+            printStorePath(info.path));
+        return true;
+    }
+
+    if (!nativeTrusted)
+        return true;
+
+    auto providerConfig = InProcessProviderConfig::validate(config->signatureObservationProviderLibrary.get());
+    auto groups = parseSignatureObservationKeyGroups(config->signatureObservationProviderKeyGroups.get());
+
+    /* Only key names actually referenced by a configured group are
+       candidates for the provider at all. This keeps the provider from
+       being asked about signatures no group cares about (a provider
+       need not support every algorithm Nix's native check does -- e.g.
+       the example provider is deliberately Ed25519-only, matching the
+       O-provider stop/go review's narrow scope -- so asking it about an
+       irrelevant algorithm would otherwise turn an unrelated signature
+       entry into a hard failure for no policy reason). */
+    std::set<std::string> requiredKeyNames;
+    for (auto & group : groups)
+        for (auto & name : group.requiredKeyNames)
+            requiredKeyNames.insert(name);
+
+    /* One provider call per raw `Sig:` entry that some group requires,
+       matching the key it claims to be from -- the provider only
+       verifies cryptography, it never sees or decides which keys are
+       eligible; that stays a property of Nix's own `getPublicKeys()`
+       trusted-key registry. */
+    std::vector<ValidPathInfo::VerifiedSignature> observed;
+    auto fp = info.fingerprint(*this);
+    std::vector<uint8_t> message(fp.begin(), fp.end());
+    auto & publicKeys = getPublicKeys();
+    for (auto & sig : info.sigs) {
+        if (!requiredKeyNames.contains(sig.keyName))
+            continue;
+        auto key = publicKeys.find(sig.keyName);
+        if (key == publicKeys.end())
+            continue;
+        auto algorithm = std::string(keyTypeProtocolName(key->second->keyType()));
+        std::vector<uint8_t> keyBytes(key->second->key.begin(), key->second->key.end());
+        std::vector<uint8_t> sigBytes(sig.sig.begin(), sig.sig.end());
+        if (invokeInProcessProvider(providerConfig, algorithm, keyBytes, message, sigBytes)) {
+            observed.push_back(ValidPathInfo::VerifiedSignature{
+                .keyName = sig.keyName,
+                .keyType = key->second->keyType(),
+                .signatureId = hashString(HashAlgorithm::SHA256, sig.sig).to_string(HashFormat::Base16, false),
+            });
+        }
+    }
+
+    return !allSignatureGroupsSatisfied(observed, groups);
 }
 
 bool LocalStore::realisationIsUntrusted(const Realisation & realisation)
