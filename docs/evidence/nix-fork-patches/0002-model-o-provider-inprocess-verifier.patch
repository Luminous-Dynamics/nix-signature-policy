diff --git a/src/libutil/signature-inprocess-provider.cc b/src/libutil/signature-inprocess-provider.cc
new file mode 100644
index 0000000..14121c6
--- /dev/null
+++ b/src/libutil/signature-inprocess-provider.cc
@@ -0,0 +1,117 @@
+#include "nix/util/signature-inprocess-provider.hh"
+#include "nix/util/signature-provider-abi.h"
+#include "nix/util/error.hh"
+#include "nix/util/sync.hh"
+
+#include <dlfcn.h>
+
+#include <map>
+
+namespace nix {
+
+InProcessProviderConfig InProcessProviderConfig::validate(std::string libraryPath)
+{
+    if (libraryPath.empty())
+        throw Error("signature-observation-provider-library is not set");
+    if (libraryPath[0] != '/')
+        throw Error(
+            "signature-observation-provider-library must be an absolute path, got '%s' (no PATH lookup is performed)",
+            libraryPath);
+    return InProcessProviderConfig{.libraryPath = std::move(libraryPath)};
+}
+
+namespace {
+
+/**
+ * Providers are loaded once and cached for the process's lifetime,
+ * keyed by library path. Never `dlclose`d: matches common real-world
+ * plugin practice avoiding static-destructor/TLS teardown hazards, and
+ * this comparison's short-lived CLI invocations have no long-running-
+ * daemon reason to reclaim the mapping.
+ */
+struct ProviderCache
+{
+    std::map<std::string, const NixSignatureProviderV1 *> loaded;
+};
+
+Sync<ProviderCache> providerCache;
+
+const NixSignatureProviderV1 * loadProvider(const std::string & libraryPath)
+{
+    auto cache(providerCache.lock());
+
+    auto it = cache->loaded.find(libraryPath);
+    if (it != cache->loaded.end())
+        return it->second;
+
+    /* RTLD_NOW: resolve all symbols immediately, so a provider with an
+       unresolvable dependency fails loudly at load time, not on first
+       use. RTLD_LOCAL: don't pollute the global symbol namespace. */
+    void * handle = dlopen(libraryPath.c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (!handle)
+        throw Error("failed to load signature observation provider '%s': %s", libraryPath, dlerror());
+
+    dlerror(); // clear any existing error, per dlsym(3)'s recommended idiom
+    auto * entry = reinterpret_cast<const NixSignatureProviderV1 * (*) (void)>(dlsym(handle, "nix_signature_provider_v1"));
+    const char * symError = dlerror();
+    if (symError)
+        throw Error(
+            "signature observation provider '%s' does not export 'nix_signature_provider_v1': %s",
+            libraryPath,
+            symError);
+
+    const NixSignatureProviderV1 * provider = entry();
+    if (!provider)
+        throw Error("signature observation provider '%s' returned a null vtable", libraryPath);
+
+    if (provider->abi_version != NIX_SIGNATURE_PROVIDER_ABI_VERSION)
+        throw Error(
+            "signature observation provider '%s' declares ABI version %d, Nix expects %d",
+            libraryPath,
+            provider->abi_version,
+            NIX_SIGNATURE_PROVIDER_ABI_VERSION);
+
+    if (!provider->verify)
+        throw Error("signature observation provider '%s' has a null 'verify' function pointer", libraryPath);
+
+    cache->loaded.emplace(libraryPath, provider);
+    return provider;
+}
+
+} // namespace
+
+bool invokeInProcessProvider(
+    const InProcessProviderConfig & config,
+    const std::string & algorithm,
+    const std::vector<uint8_t> & keyBytes,
+    const std::vector<uint8_t> & message,
+    const std::vector<uint8_t> & signatureBytes)
+{
+    const NixSignatureProviderV1 * provider = loadProvider(config.libraryPath);
+
+    /* This is a C ABI call: the provider must not throw, but we do not
+       control its implementation, so treat any propagating C++
+       exception the same as any other in-process fault -- it is not
+       caught here, deliberately, because that is exactly the
+       fault-domain trade-off this model makes and this comparison
+       needs to observe, not paper over. */
+    int result = provider->verify(
+        algorithm.c_str(),
+        keyBytes.data(),
+        keyBytes.size(),
+        message.data(),
+        message.size(),
+        signatureBytes.data(),
+        signatureBytes.size());
+
+    if (result == NIX_SIG_ERROR)
+        throw Error(
+            "signature observation provider '%s' reported an error verifying under algorithm '%s' "
+            "(not a normal signature-invalid result)",
+            config.libraryPath,
+            algorithm);
+
+    return result == NIX_SIG_VALID;
+}
+
+} // namespace nix
-- 
