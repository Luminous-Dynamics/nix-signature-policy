diff --git a/src/libstore/include/nix/store/local-store.hh b/src/libstore/include/nix/store/local-store.hh
index fde17c3..c62b19e 100644
--- a/src/libstore/include/nix/store/local-store.hh
+++ b/src/libstore/include/nix/store/local-store.hh
@@ -155,6 +155,78 @@ public:
         true,
         Xp::ConfigurableSignatureAuthorization};
 
+    Setting<std::string> signatureObservationProviderLibrary{
+        this,
+        "",
+        "signature-observation-provider-library",
+        R"(
+          Optional. Absolute path to an in-process signature observation
+          provider: a shared library implementing the small, versioned C
+          ABI in `signature-provider-abi.h` (Model O-provider in the
+          authorization-boundary-architecture comparison). The path must
+          be absolute; no `PATH` lookup is performed.
+
+          Unlike `signature-authorization-hook`, this library is loaded
+          with `dlopen` into Nix's own process and never unloaded. It
+          only reports whether a signature verifies -- it cannot itself
+          admit or refuse a path; Nix always composes its report with
+          Nix's own signature-group policy (`signature-key-group`,
+          shared with Model N). A crash or memory-safety bug in this
+          library crashes Nix's own process -- this is a deliberate,
+          documented trade-off of this model, not an oversight.
+
+          This option is only settable in the global `nix.conf`, or on
+          the command line by trusted users.
+        )",
+        {},
+        true,
+        Xp::ConfigurableSignatureAuthorization};
+
+    Setting<std::string> signatureObservationProviderMode{
+        this,
+        "legacy",
+        "signature-observation-provider-mode",
+        R"(
+          How the result of `signature-observation-provider-library` is
+          combined with Nix's own trusted-signature check. One of:
+
+          - `legacy`: the provider, if configured, is not consulted.
+            Admission is exactly Nix's existing trusted-signature
+            behavior.
+
+          - `conjunctive`: a store path is admitted only if Nix's own
+            trusted-signature check accepts it *and* the resulting
+            verified-signature observations satisfy every group in
+            `signature-key-group`. The provider can only add a
+            requirement; a provider that is unset, fails to load, or
+            reports an error is treated as a refusal, never a silent
+            acceptance. Content-addressed paths, which have no
+            meaningful signature policy, are refused under this mode
+            rather than silently admitted.
+
+          Any other value is a configuration error.
+        )",
+        {},
+        true,
+        Xp::ConfigurableSignatureAuthorization};
+
+    Setting<Strings> signatureObservationProviderKeyGroups{
+        this,
+        {},
+        "signature-observation-provider-key-groups",
+        R"(
+          Zero or more required signature groups, each in the form
+          `<group-name>:<key-name>[,<key-name>...]`. Under
+          `signature-observation-provider-mode = conjunctive`, a path is
+          admitted only if, for every listed group, at least one of that
+          group's key names produced a signature the provider verified
+          as valid. Shared format and evaluation with Model N's
+          `signature-key-group`.
+        )",
+        {},
+        true,
+        Xp::ConfigurableSignatureAuthorization};
+
     Setting<bool> readOnly{
         this,
         false,
