diff --git a/src/libstore-tests/signature-groups.cc b/src/libstore-tests/signature-groups.cc
new file mode 100644
index 0000000..40a3508
--- /dev/null
+++ b/src/libstore-tests/signature-groups.cc
@@ -0,0 +1,102 @@
+#include "nix/store/signature-groups.hh"
+
+#include <gtest/gtest.h>
+
+namespace nix {
+
+static ValidPathInfo::VerifiedSignature
+verifiedSig(std::string keyName, KeyType keyType = KeyType::Ed25519, std::string signatureId = "sig")
+{
+    return ValidPathInfo::VerifiedSignature{
+        .keyName = std::move(keyName),
+        .keyType = keyType,
+        .signatureId = std::move(signatureId),
+    };
+}
+
+TEST(allSignatureGroupsSatisfied, emptyGroupsIsVacuouslySatisfied)
+{
+    EXPECT_TRUE(allSignatureGroupsSatisfied({}, {}));
+    EXPECT_TRUE(allSignatureGroupsSatisfied({verifiedSig("k1")}, {}));
+}
+
+TEST(allSignatureGroupsSatisfied, singleGroupSingleKeySatisfiedWhenPresent)
+{
+    std::vector<KeyGroup> groups{KeyGroup{.name = "publisher", .requiredKeyNames = {"k1"}}};
+    EXPECT_TRUE(allSignatureGroupsSatisfied({verifiedSig("k1")}, groups));
+}
+
+TEST(allSignatureGroupsSatisfied, singleGroupSingleKeyRefusedWhenAbsent)
+{
+    std::vector<KeyGroup> groups{KeyGroup{.name = "publisher", .requiredKeyNames = {"k1"}}};
+    EXPECT_FALSE(allSignatureGroupsSatisfied({}, groups));
+    EXPECT_FALSE(allSignatureGroupsSatisfied({verifiedSig("other-key")}, groups));
+}
+
+// The exact benchmark policy this admission-boundary comparison is built
+// around: built-in trust succeeds AND both an Ed25519 and an ML-DSA-65
+// signature from the configured publisher are valid. "Configured
+// publisher" is two distinct per-algorithm key names bound into one
+// group -- never one key name trusted under both algorithms, matching
+// nix-signature-policy's own verified finding that real Nix cannot
+// safely dual-trust a single key name across algorithms.
+TEST(allSignatureGroupsSatisfied, hybridPublisherGroupRequiresBothAlgorithms)
+{
+    std::vector<KeyGroup> groups{
+        KeyGroup{.name = "acme-release", .requiredKeyNames = {"acme-release-ed25519-1", "acme-release-mldsa65-1"}}};
+
+    // Only the classical half: refused.
+    EXPECT_FALSE(allSignatureGroupsSatisfied(
+        {verifiedSig("acme-release-ed25519-1", KeyType::Ed25519)},
+        groups));
+
+    // Only the PQ half: refused.
+    EXPECT_FALSE(allSignatureGroupsSatisfied(
+        {verifiedSig("acme-release-mldsa65-1", KeyType::MLDSA65)},
+        groups));
+
+    // Both halves, plus an unrelated third-party signature: satisfied.
+    // The third-party signature proves group satisfaction doesn't
+    // require *exclusively* the group's own keys to be present, only
+    // that the group's own required keys are all covered.
+    EXPECT_TRUE(allSignatureGroupsSatisfied(
+        {
+            verifiedSig("acme-release-ed25519-1", KeyType::Ed25519),
+            verifiedSig("acme-release-mldsa65-1", KeyType::MLDSA65),
+            verifiedSig("unrelated-third-party-key", KeyType::Ed25519),
+        },
+        groups));
+}
+
+TEST(allSignatureGroupsSatisfied, multipleGroupsAllMustBeSatisfied)
+{
+    std::vector<KeyGroup> groups{
+        KeyGroup{.name = "publisher-a", .requiredKeyNames = {"a1"}},
+        KeyGroup{.name = "publisher-b", .requiredKeyNames = {"b1"}},
+    };
+
+    // Only one group's key present: whole policy refused.
+    EXPECT_FALSE(allSignatureGroupsSatisfied({verifiedSig("a1")}, groups));
+
+    // Both groups' keys present: satisfied.
+    EXPECT_TRUE(allSignatureGroupsSatisfied({verifiedSig("a1"), verifiedSig("b1")}, groups));
+}
+
+TEST(allSignatureGroupsSatisfied, sameNameDifferentAlgorithmDoesNotCollapseRequirement)
+{
+    // Two distinct required key *names* per the established pattern --
+    // a single key name is never trusted across two algorithms. This
+    // test pins that the group is keyed purely on `keyName`, matching
+    // that design: a verified signature under one key name satisfies a
+    // requirement for that exact key name regardless of which algorithm
+    // verified it, but two different required names are never conflated
+    // into one.
+    std::vector<KeyGroup> groups{
+        KeyGroup{.name = "publisher", .requiredKeyNames = {"k-ed25519", "k-mldsa65"}}};
+
+    EXPECT_FALSE(allSignatureGroupsSatisfied({verifiedSig("k-ed25519", KeyType::Ed25519)}, groups));
+    EXPECT_TRUE(allSignatureGroupsSatisfied(
+        {verifiedSig("k-ed25519", KeyType::Ed25519), verifiedSig("k-mldsa65", KeyType::MLDSA65)}, groups));
+}
+
+} // namespace nix
