diff --git a/src/libstore/include/nix/store/signature-groups.hh b/src/libstore/include/nix/store/signature-groups.hh
new file mode 100644
index 0000000..f4dea11
--- /dev/null
+++ b/src/libstore/include/nix/store/signature-groups.hh
@@ -0,0 +1,59 @@
+#pragma once
+///@file
+
+#include "nix/store/path-info.hh"
+
+#include <string>
+#include <vector>
+
+namespace nix {
+
+/**
+ * A named requirement: every one of `requiredKeyNames` must have
+ * positively verified for this group to be satisfied. Distinct from
+ * Nix's existing any-valid `trusted-public-keys` model, which requires
+ * only one valid signature from any configured key.
+ *
+ * Deliberately does not name an algorithm directly -- which algorithm a
+ * given key name means is determined once, by the trusted key registry
+ * that produced the `VerifiedSignature`s this group is checked against,
+ * not re-declared here. A `KeyGroup` only expresses "these key
+ * identities, together."
+ */
+struct KeyGroup
+{
+    std::string name;
+    std::vector<std::string> requiredKeyNames;
+
+    bool operator==(const KeyGroup &) const = default;
+};
+
+/**
+ * Native grouped-signature admission policy: every configured group
+ * must be satisfied, where a group is satisfied when every one of its
+ * `requiredKeyNames` appears among `verified`.
+ *
+ * This is a pure function over already-verified observations -- it
+ * never touches raw signature bytes, a store, or a public-key registry
+ * itself. `ValidPathInfo::checkSignaturesDetailed()` (or an equivalent
+ * per-signature verification pass) is expected to have already produced
+ * `verified` before this is called. That separation mirrors the
+ * `nix-signature-policy` project's own `core-v1`: representation-neutral
+ * policy evaluation, decoupled from cryptographic verification, so this
+ * function is trivially unit-testable without any real key material.
+ *
+ * An empty `groups` list is vacuously satisfied (`true`) -- matches
+ * today's behavior when no groups are configured, so this function is
+ * safe to call unconditionally once wired into an admission path,
+ * without itself changing behavior for a caller that configures no
+ * groups.
+ *
+ * Does not by itself decide store-path admission -- a caller composes
+ * this result with Nix's own built-in trust decision under whatever
+ * enforcement mode it chooses, the same B/P composition principle used
+ * throughout this admission-boundary experiment.
+ */
+bool allSignatureGroupsSatisfied(
+    const std::vector<ValidPathInfo::VerifiedSignature> & verified, const std::vector<KeyGroup> & groups);
+
+} // namespace nix
