diff --git a/src/libstore/signature-groups.cc b/src/libstore/signature-groups.cc
new file mode 100644
index 0000000..3210414
--- /dev/null
+++ b/src/libstore/signature-groups.cc
@@ -0,0 +1,22 @@
+#include "nix/store/signature-groups.hh"
+
+#include <algorithm>
+
+namespace nix {
+
+bool allSignatureGroupsSatisfied(
+    const std::vector<ValidPathInfo::VerifiedSignature> & verified, const std::vector<KeyGroup> & groups)
+{
+    auto hasKey = [&](const std::string & keyName) {
+        return std::any_of(verified.begin(), verified.end(), [&](const auto & v) { return v.keyName == keyName; });
+    };
+
+    return std::all_of(groups.begin(), groups.end(), [&](const KeyGroup & group) {
+        return std::all_of(
+            group.requiredKeyNames.begin(), group.requiredKeyNames.end(), [&](const std::string & keyName) {
+                return hasKey(keyName);
+            });
+    });
+}
+
+} // namespace nix
