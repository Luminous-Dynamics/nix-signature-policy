 }
 
 bool ValidPathInfo::checkSignature(
@@ -135,6 +131,39 @@ bool ValidPathInfo::checkSignature(
     return verifyDetached(fingerprint(store), sig, publicKeys);
 }
 
+ValidPathInfo::SignatureCheckResult
+ValidPathInfo::checkSignaturesDetailed(const StoreDirConfig & store, const PublicKeys & publicKeys) const
+{
+    if (isContentAddressed(store))
+        return {.validCount = maxSigs, .verified = {}};
+
+    SignatureCheckResult result{.validCount = 0, .verified = {}};
+    auto fp = fingerprint(store);
+    for (auto & sig : sigs) {
+        auto key = publicKeys.find(sig.keyName);
+        if (key == publicKeys.end())
+            continue;
+        if (key->second->verifyDetachedAnon(fp, sig)) {
+            result.validCount++;
+            result.verified.push_back(VerifiedSignature{
+                .keyName = sig.keyName,
+                .keyType = key->second->keyType(),
+                .signatureId = hashString(HashAlgorithm::SHA256, sig.sig).to_string(HashFormat::Base16, false),
+            });
+        }
+    }
+
+    // Deterministic order independent of `sigs`'s own internal
+    // ordering, so serializing this result is reproducible.
+    std::sort(result.verified.begin(), result.verified.end(), [](const auto & a, const auto & b) {
+        if (a.keyName != b.keyName)
+            return a.keyName < b.keyName;
+        return keyTypeProtocolName(a.keyType) < keyTypeProtocolName(b.keyType);
+    });
+
+    return result;
+}
+
 Strings ValidPathInfo::shortRefs() const
 {
     Strings refs;
