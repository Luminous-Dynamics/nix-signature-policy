     throw Error("conversion to PEM is not implemented for this key type");
 }
 
+std::string_view keyTypeProtocolName(KeyType type)
+{
+    // Mirrors keyTypeMap's strings exactly (not derived from it
+    // programmatically, so this stays correct even if that map's
+    // iteration order or internal representation changes).
+    switch (type) {
+    case KeyType::Ed25519:
+        return "ed25519";
+    case KeyType::MLDSA44:
+        return "ml-dsa-44";
+    case KeyType::MLDSA65:
+        return "ml-dsa-65";
+    case KeyType::MLDSA87:
+        return "ml-dsa-87";
+    case KeyType::ECDSAP384:
+        return "ecdsa-p384";
+    }
+    throw Error("no protocol name defined for this key type");
+}
