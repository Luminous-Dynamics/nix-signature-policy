+    /**
+     * The cryptographic algorithm this key uses. Lets a caller that
+     * verified a signature (e.g. an external authorization boundary)
+     * report *which* algorithm verified it, not only that some trusted
+     * key did. Pure virtual rather than a throwing default: every
+     * concrete key type must declare its algorithm at compile time, so
+     * a future or overlooked subclass fails to build rather than
+     * successfully verifying a signature and then throwing when asked
+     * what algorithm did the verifying.
+     */
+    virtual KeyType keyType() const = 0;
 };
 
+/**
+ * Frozen wire-format name for a `KeyType`, for protocols that must not
+ * serialize the enum's numeric value (which is not a stable ABI/wire
+ * contract). Matches nix-signature-policy's `AlgorithmId` strings.
+ */
+std::string_view keyTypeProtocolName(KeyType type);
+
 /**
  * Map from key names to public keys
