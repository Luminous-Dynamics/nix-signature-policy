 namespace nix {
 
@@ -209,6 +210,66 @@ struct ValidPathInfo : virtual UnkeyedValidPathInfo
      */
     bool checkSignature(const StoreDirConfig & store, const PublicKeys & publicKeys, const Signature & sig) const;
 
+    /**
+     * A single positively verified signature observation: the key
+     * identity that produced it and the algorithm used to verify it.
+     * Distinct from `Signature` (a claimed key name plus raw signature
+     * bytes, neither of which is trustworthy before verification).
+     *
+     * `signatureId` is a stable, opaque identity for the raw signature
+     * bytes (a content hash) -- exact duplicate signatures share it;
+     * distinct signatures, even from the same `keyName`, do not. It
+     * exists so an external policy consumer can distinguish "the same
+     * signature reported twice" from "two different signatures from
+     * one key" without seeing raw cryptographic bytes.
+     */
+    struct VerifiedSignature
+    {
+        std::string keyName;
+        KeyType keyType;
+        std::string signatureId;
+
+        bool operator==(const VerifiedSignature &) const = default;
+    };
+
+    struct SignatureCheckResult
+    {
+        /**
+         * Same value `checkSignatures` returns: the count of valid
+         * signatures, or `maxSigs` for a content-addressed path.
+         */
+        size_t validCount;
+
+        /**
+         * One entry per signature that positively verified, sorted by
+         * `(keyName, keyType)` for deterministic serialization
+         * regardless of `sigs`'s own internal ordering. Empty (not
+         * `maxSigs`-flagged) for a content-addressed path -- see
+         * `validCount` for that signal instead.
+         *
+         * This is a bounded set of positively verified observations,
+         * not a complete per-signature pass/fail map: unknown key
+         * names, known keys with invalid signatures, and malformed
+         * signature entries are omitted by design, not merely
+         * unimplemented. A caller that needs to distinguish "no
+         * evidence was offered" from "evidence was offered and
+         * rejected" cannot do so from this field alone.
+         */
+        std::vector<VerifiedSignature> verified;
+    };
+
+    /**
+     * Verify every signature exactly once and report both the count
+     * `checkSignatures` returns and the detailed per-signature
+     * observations an external authorization boundary needs --
+     * deliberately one verification pass computing both, not two
+     * independent passes that could drift or double the cryptographic
+     * work (ML-DSA verification is not free). `checkSignatures` is a
+     * thin wrapper around this method's `validCount` and its behavior,
+     * including the content-addressed short-circuit, is unchanged.
+     */
+    SignatureCheckResult checkSignaturesDetailed(const StoreDirConfig & store, const PublicKeys & publicKeys) const;
+
     /**
      * References as store path basenames, including a self reference if it has one.
      */
