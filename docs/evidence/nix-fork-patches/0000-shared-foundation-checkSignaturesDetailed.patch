@@ -100,6 +100,61 @@ public:
         "require-sigs",
         "Whether store paths copied into this store should have a trusted signature."};
 
+    Setting<std::string> signatureAuthorizationHook{
+        this,
+        "",
+        "signature-authorization-hook",
+        R"(
+          Optional. Absolute path to an external program consulted during
+          store-path admission, in addition to (never instead of) the
+          ordinary `trusted-public-keys` signature check.
+
+          The path must be absolute; no `PATH` lookup is performed. When
+          empty (the default), no external program is consulted and
+          admission behaves exactly as it does without this option
+          (`legacy` mode).
+
+          This option is only settable in the global `nix.conf`, or on the
+          command line by trusted users.
+        )",
+        {},
+        true,
+        Xp::ConfigurableSignatureAuthorization};
+
+    Setting<std::string> signatureAuthorizationMode{
+        this,
+        "legacy",
+        "signature-authorization-mode",
+        R"(
+          How the result of `signature-authorization-hook` is combined
+          with Nix's own trusted-signature check. One of:
+
+          - `legacy`: the hook, if configured, is not consulted. Admission
+            is exactly Nix's existing trusted-signature behavior.
+
+          - `conjunctive`: a store path is admitted only if *both* Nix's
+            own trusted-signature check *and* the hook accept it. The
+            hook can only add a requirement; it can never admit a path
+            Nix's own check refuses, and a hook that is unset, times out,
+            crashes, or returns a malformed response is treated as a
+            refusal, never a silent acceptance.
+
+          Any other value is a configuration error.
+        )",
+        {},
+        true,
+        Xp::ConfigurableSignatureAuthorization};
+
+    Setting<unsigned int> signatureAuthorizationTimeoutMs{
+        this,
+        2000,
+        "signature-authorization-timeout-ms",
+        "Milliseconds to wait for `signature-authorization-hook` before treating the invocation as failed "
+        "(and, in `conjunctive` mode, refusing the path).",
+        {},
+        true,
+        Xp::ConfigurableSignatureAuthorization};
